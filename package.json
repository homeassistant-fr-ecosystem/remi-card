{
  "name": "remi-card",
  "version": "1.0.1-b10",
  "description": "A custom card for displaying Rémi UrbanHello device data in Home Assistant",
  "type": "module",
  "module": "dist/remi-card.js",
  "main": "dist/remi-card.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/urbanhello/remi-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "remi",
    "urbanhello"
  ],
  "scripts": {
    "build": "node scripts/generate-version.js && rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "custom-card-helpers": "^2.2.1",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@rollup/plugin-url": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "rollup": "^4.68.6",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.1"
  }
}
